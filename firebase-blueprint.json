{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A user-owned task item with title, description, category, priority, due date, and completion status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the authenticated user who owns the task.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Short required task title.",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Optional task details or notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Task category label such as Academic, Work, Personal, Study, Project, or General.",
          "minLength": 1,
          "maxLength": 40
        },
        "priority": {
          "type": "string",
          "description": "Task urgency level.",
          "enum": ["Low", "Medium", "High"]
        },
        "dueDate": {
          "type": "string",
          "description": "Optional due date in YYYY-MM-DD format or empty string.",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$"
        },
        "status": {
          "type": "string",
          "description": "Current workflow state of the task.",
          "enum": ["Pending", "Completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-assigned creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-assigned last modification timestamp."
        }
      },
      "required": [
        "userId",
        "title",
        "description",
        "category",
        "priority",
        "dueDate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Private tasks owned by an authenticated user."
    }
  }
}
