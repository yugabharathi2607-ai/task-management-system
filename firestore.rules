rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPriority(priority) {
      return priority is string && priority in ['Low', 'Medium', 'High'];
    }

    function isValidStatus(status) {
      return status is string && status in ['Pending', 'Completed'];
    }

    function isValidDueDate(dueDate) {
      return dueDate is string && dueDate.size() <= 10 && dueDate.matches('^(|\\d{4}-\\d{2}-\\d{2})$');
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll([
          'userId',
          'title',
          'description',
          'category',
          'priority',
          'dueDate',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'description',
          'category',
          'priority',
          'dueDate',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 40
        && isValidPriority(data.priority)
        && isValidDueDate(data.dueDate)
        && isValidStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isToggleStatusAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status != existing().status;
    }

    function isEditTaskAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'title',
        'description',
        'category',
        'priority',
        'dueDate',
        'status',
        'updatedAt'
      ]);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(taskId) && isOwner(userId);

      allow list: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(taskId)
        && isOwner(userId)
        && isValidTask(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidId(taskId)
        && isOwner(userId)
        && isValidTask(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isToggleStatusAction() || isEditTaskAction());

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(taskId) && isOwner(userId);
    }
  }
}
